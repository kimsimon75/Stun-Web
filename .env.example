# Copy to .env and enter your PutUpdate API Gateway HTTPS endpoint.
UPDATE_API_URL=
# After deploying the authenticated publisher (takes priority over direct S3).
PATCH_API_URL=
# Optional existing AWS profile for S3 publishing.
# AWS_PROFILE=default

# EXE settings: copy these into dist/.env (not .env.example).
UNIT_API_URL=https://stun-calculator.netlify.app/.netlify/functions/unit-snapshots
# 64 lowercase hexadecimal characters; same value in Netlify Functions environment.
UNIT_BRIDGE_TOKEN=
# The EXE creates web-read-token.txt. Paste that READ code into the web panel.
